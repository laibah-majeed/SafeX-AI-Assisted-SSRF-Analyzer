# Copy this file to .env and fill in values as needed.
# Never commit your real .env file.

# --- Authorized lab targets -------------------------------------------------
# Comma-separated list of ADDITIONAL hostnames/IPs you explicitly authorize
# for scanning, beyond the built-in localhost/127.0.0.1/::1 defaults.
# Example: SSRF_LAB_ALLOWED_HOSTS=lab.local,192.168.56.10
SSRF_LAB_ALLOWED_HOSTS=

# --- Network safety limits ---------------------------------------------------
SSRF_REQUEST_TIMEOUT=5
SSRF_MAX_RESPONSE_BYTES=200000
SSRF_MAX_REDIRECTS=3
SSRF_BASELINE_SAMPLES=2

# --- AI-assisted interpretation ---------------------------------------------
# AI_PROVIDER: "anthropic", "openai", or "none".
# If left blank or the matching API key is not set, a deterministic
# fallback interpretation is used automatically — the app still runs fully.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- CORS --------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
